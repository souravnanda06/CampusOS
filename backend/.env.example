# CampusOS Backend Environment Configuration Example
# Copy this file to .env and adjust values for your local environment

# Database Configuration
DATABASE_URL=mysql+pymysql://root:password@localhost/campusos

# Cryptographic Keys (Ed25519 & HMAC-SHA256)
PASSPORT_INSTITUTION_KEY_ID=campusos-root-2026-v1
PASSPORT_INSTITUTION_PRIVATE_KEY=your_base64_ed25519_private_key_here
GATE_PASS_SECRET=your_gate_pass_hmac_secret_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION_HOURS=168
